# Copy this file to .env and fill in your Strava app credentials.
# Create a Strava app at https://www.strava.com/settings/api
#   - "Authorization Callback Domain" must be: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Comma-separated list of Strava athlete IDs allowed to sign in.
# Leave empty to allow anyone (fine for local dev; lock it down before deploying).
# Find your Strava athlete ID at: strava.com/settings/profile (it's in the URL).
STRAVA_WHITELIST=

# Where the web app runs in dev (used for the post-OAuth redirect)
WEB_URL=http://localhost:5173
# Where this API runs (used to build the OAuth callback URL)
API_URL=http://localhost:8787
